{
  "name": "smartlab-v4",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "elab:up": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env up -d --build",
    "elab:imagej:up": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env --profile imagej up -d --build imagej-worker",
    "elab:down": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env down",
    "elab:logs": "docker compose -f deploy/local/docker-compose.yml --env-file deploy/local/.env logs -f",
    "elab:phase1:apply": "tsx tools/elabftw/apply-phase1.ts",
    "elab:phase1:seed": "tsx tools/elabftw/seed-phase1.ts"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "mysql2": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "playwright": "^1.60.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
