{
    admin off
    auto_https off
    servers {
        trusted_proxies static 127.0.0.1/32 ::1/128
    }
}
http://:3180 {
    bind 127.0.0.1
    @apphost host smartlab-v2.sumhs.org localhost 127.0.0.1
    handle @apphost {
        reverse_proxy https://127.0.0.1:3159 {
            header_up Host {http.request.host}
            header_up X-Forwarded-Proto https
            transport http {
                tls_trust_pool file /etc/caddy/smartlab-ca.pem
                tls_server_name localhost
            }
        }
    }
    handle {
        respond "Not found" 404
    }
}
