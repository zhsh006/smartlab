page { background: #f3f5f8; color: #1e2733; font-size: 28rpx; }
.card { background: #fff; border-radius: 16rpx; margin: 20rpx; padding: 28rpx; }
.card + .card { margin-top: 0; }
h2, .h2 { font-size: 36rpx; font-weight: 700; margin: 0 0 12rpx; }
.muted { color: #66727f; font-size: 24rpx; }
.field { margin-top: 20rpx; }
.field .label { font-size: 24rpx; font-weight: 600; margin-bottom: 8rpx; }
input { border: 1rpx solid #e2e7ee; border-radius: 12rpx; padding: 22rpx; }
button { border-radius: 12rpx; font-size: 30rpx; margin-top: 24rpx; }
.btn-primary { background: #0a66c2; color: #fff; }
.btn-ghost { background: #fff; border: 1rpx solid #e2e7ee; color: #1e2733; }
.row { align-items: center; border-bottom: 1rpx solid #eef1f6; display: flex; padding: 22rpx 0; }
.row:last-child { border-bottom: 0; }
.row .t { flex: 1; min-width: 0; }
.row .t .tt { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row .t .sub { color: #66727f; font-size: 24rpx; }
.chip { background: #eef1f5; border-radius: 999rpx; color: #66727f; font-size: 22rpx; padding: 4rpx 18rpx; }
.chip.ok { background: #e6f4ec; color: #1a7f4b; }
.step { align-items: center; border-bottom: 1rpx solid #eef1f6; display: flex; padding: 18rpx 0; }
.step:last-child { border-bottom: 0; }
.dot { align-items: center; background: #eef1f5; border-radius: 50%; color: #5b6675; display: flex; font-size: 22rpx; height: 40rpx; justify-content: center; margin-right: 16rpx; width: 40rpx; }
.dot.done { background: #e6f4ec; color: #1a7f4b; }
.err { color: #c0392b; font-size: 24rpx; margin-top: 12rpx; }
.qr-title { text-align: center; }
